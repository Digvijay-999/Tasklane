# Copy this file to .env and adjust values:   Copy-Item .env.example .env
# .env is gitignored. Never commit real secrets.

# PostgreSQL (used by the postgres container and the API)
POSTGRES_USER=tasklane
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tasklane

# Host ports. Each one is bound to 127.0.0.1 only. Change one if it's already in use on your
# machine (for example, POSTGRES_HOST_PORT=5433 if you already run Postgres locally).
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO

# Deadline in seconds (2-30) for the /health/ready dependency checks and connection attempts.
DEPENDENCY_TIMEOUT_SECONDS=2

# Upload limits in bytes (50 MiB for PDF, 100 MiB for ZIP), enforced while the file streams in.
MAX_PDF_UPLOAD_BYTES=52428800
MAX_ZIP_UPLOAD_BYTES=104857600
# How long (hours) an upload can be used to create jobs.
UPLOAD_TTL_HOURS=24
# Limit in bytes for JSON request bodies (every route except uploads).
MAX_JSON_BODY_BYTES=65536

# --- Queue (dispatcher and worker) ---
# Seconds between dispatcher polls of the outbox, and rows published per pass.
DISPATCH_POLL_SECONDS=1
DISPATCH_BATCH_SIZE=50
# Seconds to wait for Redis when publishing before treating it as down.
PUBLISH_TIMEOUT_SECONDS=2
# A running attempt's lease, renewed by the worker's heartbeat thread. A worker that stops
# renewing it (killed, crashed) is presumed dead once it runs out, and recovery retries the job.
LEASE_SECONDS=60
# Heartbeat interval in seconds. Unset or empty = a quarter of LEASE_SECONDS; at most a third.
# HEARTBEAT_INTERVAL_SECONDS=15
# Redis redelivers unacknowledged messages after this long. Must be longer than LEASE_SECONDS.
CELERY_VISIBILITY_TIMEOUT_SECONDS=900
# Last-resort limit after which Celery kills a task.
CELERY_TASK_TIME_LIMIT_SECONDS=3600
# Worker processes in the worker container.
WORKER_CONCURRENCY=2

# --- Recovery (runs in the dispatcher container) ---
# Seconds between recovery passes (expired leases, lost messages). At most LEASE_SECONDS.
RECOVERY_INTERVAL_SECONDS=5
# A queued (or overdue retry_wait) job whose last message went out more than this many seconds
# ago, with no worker on it, gets a new message. At least twice RECOVERY_INTERVAL_SECONDS.
LOST_MESSAGE_GRACE_SECONDS=300

# --- PDF workflow ---
# Limits on uploaded PDFs, enforced in a separate parser process. A PDF over a limit fails with a
# clear message (it is never silently truncated).
PDF_MAX_PAGES=500
PDF_MAX_TEXT_CHARS=2000000
PDF_VALIDATE_TIMEOUT_SECONDS=60
PDF_EXTRACT_TIMEOUT_SECONDS=300
PDF_PARSER_MEMORY_MB=1024
# Summarization provider. "stub" is built in: deterministic, offline, no API key.
PROVIDER=stub
# Per-call timeout; must be at most half of LEASE_SECONDS.
PROVIDER_TIMEOUT_SECONDS=20
SUMMARIZE_TIMEOUT_SECONDS=900
# Development only: the stub provider waits this many seconds per call, so a job runs long
# enough to watch its progress or to stop the worker mid-job (e.g. 2). Must be below
# PROVIDER_TIMEOUT_SECONDS.
STUB_DELAY_SECONDS=0

# --- Repository ZIP workflow ---
# Limits on uploaded repository ZIPs, enforced in a separate process while extracting. Sizes are
# the real decompressed bytes (sizes written in the ZIP are never trusted).
ZIP_MAX_ENTRIES=5000
# 500 MiB of extracted files in total, 5 MiB per file (bigger files are skipped as too_large).
ZIP_MAX_TOTAL_BYTES=524288000
ZIP_MAX_FILE_BYTES=5242880
# Reject the archive if an entry, or the archive overall, is compressed more than this (a zip
# bomb), once it has produced at least ZIP_RATIO_CHECK_MIN_BYTES.
ZIP_MAX_COMPRESSION_RATIO=100
ZIP_RATIO_CHECK_MIN_BYTES=1048576
# Longer or deeper paths are skipped (path_too_long / path_too_deep).
ZIP_MAX_PATH_LENGTH=240
ZIP_MAX_PATH_DEPTH=20
ZIP_VALIDATE_TIMEOUT_SECONDS=60
ZIP_EXTRACT_TIMEOUT_SECONDS=300
ZIP_SANDBOX_MEMORY_MB=512
# Folder names never indexed, comma-separated. Empty = the built-in list (.git, node_modules,
# dist, build, target, __pycache__, .venv, venv, .idea, .vscode, coverage, vendor, ...).
REPO_EXCLUDED_DIRS=
# A repository needing more summarization calls than this fails with repo_too_large.
REPO_MAX_PROVIDER_CALLS=1000

# Automatic retries of transient failures: equal-jitter backoff over
# min(RETRY_BASE_SECONDS * 2^(n-1), RETRY_MAX_SECONDS): first retry 2.5-5 s, second 5-10 s.
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
# Development only: lets jobs request injected provider failures (option "fault_injection").
# Leave it off; to try it, set it in your shell for one session instead of here.
# ENABLE_FAULT_INJECTION=false

# --- Event stream (SSE), per API process ---
# Open streams allowed at once (one more gets 503 stream_limit_reached).
SSE_MAX_STREAMS=50
# Seconds before a stream is closed with its last id (the client reconnects and resumes).
SSE_MAX_STREAM_SECONDS=3600
# Seconds between database checks for new events while a stream is open.
SSE_POLL_SECONDS=0.5
# Seconds without output before a ": keepalive" comment is sent. At least SSE_POLL_SECONDS.
SSE_KEEPALIVE_SECONDS=15
# Reconnect delay the server asks browsers to use, in milliseconds.
SSE_RETRY_MILLISECONDS=3000
# A client that can't accept a write for this many seconds (not reading) is disconnected.
SSE_WRITE_TIMEOUT_SECONDS=30

# Make the dev reloader poll for file changes (needed on Docker Desktop for Windows).
WATCHFILES_FORCE_POLLING=true
